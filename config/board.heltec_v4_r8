# Heltec WiFi LoRa 32 V4-R8: ESP32-S3R8 (16 MiB flash, 8 MiB octal PSRAM), native USB.
# The octal PSRAM takes GPIO33 to GPIO37, so Vext moves to GPIO40 and the
# front end is the KCT8103L alone (ah_board.c).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_AH_BOARD_HELTEC_V4_R8=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# NimBLE takes its buffers from PSRAM, leaving internal RAM to the radios.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
