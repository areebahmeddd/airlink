# Build output: idf.py (build/<board>-<profile>), the host tests and fuzzers
build/
build-*/
managed_components/
__pycache__/
*.pyc

# Generated configuration: a build's sdkconfig is never committed; the
# dependencies.lock.<target> files are
sdkconfig
sdkconfig.old

# Images and signing outputs are release artifacts, never sources, and so is
# what the Publish Web Flasher workflow adds to the flasher
*.bin
*.elf
*.map
*.ahot
SHA256SUMS
flasher/firmware/
flasher/manifests/
flasher/esp-web-tools/

# Keys live offline, never here (docs/RELEASE.md)
*owner_key*.pem
*secure_boot_signing_key*.pem

# Editors and logs
.vscode/
.idea/
.DS_Store
*.log
