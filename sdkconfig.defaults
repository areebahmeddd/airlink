# Every build's settings. scripts/build.sh layers a board (config/board.<name>)
# and a profile (config/profile.<name>) on top, and ESP-IDF loads
# sdkconfig.defaults.<target> right after this file.

# Build
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
# Boot verifies the OTA manifest's Ed25519 signature and hashes the running
# image on this task, which comes within a few hundred bytes of the 3.5 KiB
# default. The stack is freed once app_main returns.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120

# Flash layout (partitions-*.csv); each board file names its flash size, and a
# 4 MiB board its own table.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8mb.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Reliability: a task watchdog that resets, and a core dump to read after a
# crash (the interrupt watchdog and brownout detection are on by default).
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Power: frequency scaling only, configured in app_main.
CONFIG_PM_ENABLE=y

# Bluetooth: NimBLE, whose defaults already turn on all four roles and both
# GATT sides and persist nothing (bitchat never pairs or bonds).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=6
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Internal RAM: code that never runs with the flash cache off lives in flash,
# leaving its RAM to the heap (no IRAM interrupt handler here allocates or
# drives the SPI bus; ESP-IDF then keeps the SPI master's ISR out of IRAM).
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
